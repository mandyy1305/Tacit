<resources>
    <!-- TACIT window theme. Compose (TacitTheme) paints everything; this only controls
         the bare window behind it, so a plain platform parent is enough. -->
    <style name="Theme.Tacit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/tacit_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Cold-start splash: paper field with the "T." monogram, handing off to Theme.Tacit. -->
    <style name="Theme.Tacit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tacit_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tacit</item>
    </style>
</resources>
