<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Capture the speaker-played voice note via the mic.
         RECORD_AUDIO is also required to build ANY AudioRecord, including the
         internal-audio (AudioPlaybackCapture) path. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WhatsApp voice notes live under Android/media/com.whatsapp/.../WhatsApp Voice Notes/ and are
         kept OUT of MediaStore by a .nomedia marker, so MediaStore.Audio cannot see them (it only
         indexes the WhatsApp Audio folder). Direct file access is therefore the only reliable path,
         which on Android 11+ needs all-files access. READ_MEDIA_AUDIO is kept only so the MediaStore
         supplement can pick up the Audio folder. TODO (Play compliance): replace all-files with a
         Storage Access Framework folder grant (ACTION_OPEN_DOCUMENT_TREE on the Voice Notes folder);
         until that ships, all-files is required for the app to function. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Internal audio capture (MediaProjection + AudioPlaybackCapture) must run from a
         foreground service. FOREGROUND_SERVICE has existed since API 28; the typed
         permission FOREGROUND_SERVICE_MEDIA_PROJECTION is new in API 34 and is enforced
         when targetSdk >= 34 (we target 36). POST_NOTIFICATIONS (API 33+) only makes the
         mandatory FGS notification visible — capture works without it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Mic fallback runs in a foreground service (type=microphone) — required because Android mutes
         the mic for background apps; capturing from the accessibility service alone yields silence. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Floating result card + scrollable debug dump drawn over WhatsApp. Granted via a
         Settings screen (not a runtime dialog); checked with Settings.canDrawOverlays(). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- One-time download of the whisper-small ASR model to filesDir. Normal/install-time perm. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!-- Android 11+ package-visibility filter: without this, getPackageInfo("com.whatsapp")
         throws NameNotFoundException even when WhatsApp is installed, and Home shows the
         "WhatsApp isn't on this phone" state. w4b is WhatsApp Business (also scanned). -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".app.TacitApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tacit.Starting">
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Invisible trampoline so the overlay's "Share screen" button can request MediaProjection
             consent (a service can't startActivityForResult). Translucent so nothing flashes. -->
        <activity
            android:name=".audio.ProjectionRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Internal-audio capture (MediaProjection + AudioPlaybackCapture) owns a
             mediaProjection-typed foreground service. On Android 14+ the system requires the
             FGS (with this exact type) to be running BEFORE getMediaProjection() is called. -->
        <service
            android:name=".audio.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Mic-fallback capture host (foreground service, type=microphone). -->
        <service
            android:name=".audio.MicCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Accessibility service, scoped to com.whatsapp via the config below. The
             android:permission=BIND_ACCESSIBILITY_SERVICE is what the OS requires so only the
             system can bind it; the user must still enable it manually in Settings. -->
        <service
            android:name=".pipeline.WhatsAppAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Firebase Cloud Messaging: receives the server's "transcript ready" push when a
             long note finishes transcribing via the Sarvam batch API. -->
        <service
            android:name=".cloud.TacitMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>